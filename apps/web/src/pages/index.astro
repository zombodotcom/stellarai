---
// The engine island. Everything below the fold is client-side three.js;
// the physics lives in @stellarai/astro-core and @stellarai/scale-graph,
// both fully unit-tested — this page only hosts the canvas and controls.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>StellarAI</title>
    <style is:global>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: #02030a;
        color: #cdd6e8;
        font-family: system-ui, sans-serif;
        overflow: hidden;
      }
      #scene {
        display: block;
        width: 100vw;
        height: 100vh;
        touch-action: none;
      }
      #hud {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background: rgba(4, 8, 20, 0.72);
        border: 1px solid #24304a;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        backdrop-filter: blur(4px);
      }
      #hud h1 {
        margin: 0;
        font-size: 1rem;
        letter-spacing: 0.08em;
        font-weight: 600;
      }
      #hud .row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      #epoch {
        font-variant-numeric: tabular-nums;
        color: #8fa3c8;
      }
      select,
      button {
        background: #0b1224;
        color: #cdd6e8;
        border: 1px solid #2b3a5c;
        border-radius: 0.3rem;
        padding: 0.2rem 0.5rem;
        font-size: 0.85rem;
      }
      button[data-active='true'] {
        border-color: #6b93d6;
        color: #fff;
      }
      #entry-panel {
        position: fixed;
        top: 0.75rem;
        right: 0.75rem;
        width: 292px;
        background: rgba(4, 8, 20, 0.72);
        border: 1px solid #24304a;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        backdrop-filter: blur(4px);
      }
      #entry-panel h2 {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        font-weight: 600;
        color: #8fa3c8;
      }
      #entry-panel .row {
        display: grid;
        grid-template-columns: 6.2rem 1fr 4.6rem;
        align-items: center;
        gap: 0.4rem;
        margin: 0.25rem 0;
      }
      #entry-panel .row span {
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: #8fa3c8;
      }
      #entry-panel input[type='range'] {
        width: 100%;
      }
      #entry-panel .readout {
        display: flex;
        gap: 1rem;
        margin: 0.6rem 0 0.4rem;
      }
      #entry-panel .readout div {
        display: flex;
        flex-direction: column;
      }
      #entry-panel .readout span {
        font-size: 0.95rem;
        color: #fff;
        font-variant-numeric: tabular-nums;
      }
      #entry-panel .readout small {
        color: #64769a;
      }
      #entry-panel svg {
        width: 100%;
        background: rgba(10, 16, 34, 0.6);
        border-radius: 0.3rem;
      }
      #entry-panel .note {
        margin: 0.5rem 0 0;
        color: #64769a;
        font-size: 0.68rem;
        line-height: 1.35;
      }
    </style>
  </head>
  <body>
    <canvas id="scene"></canvas>
    <div id="hud">
      <h1>StellarAI</h1>
      <div class="row">
        <span id="epoch"></span>
      </div>
      <div class="row">
        <label for="focus">focus</label>
        <select id="focus">
          <option value="sun" selected>Sun</option>
          <option value="mercury">Mercury</option>
          <option value="venus">Venus</option>
          <option value="earth">Earth</option>
          <option value="mars">Mars</option>
          <option value="jupiter">Jupiter</option>
          <option value="saturn">Saturn</option>
          <option value="uranus">Uranus</option>
          <option value="neptune">Neptune</option>
          <option value="pluto">Pluto</option>
        </select>
      </div>
      <div class="row" id="rates">
        <button data-rate="0" data-active="true">pause</button>
        <button data-rate="86400">1 d/s</button>
        <button data-rate="2592000">30 d/s</button>
        <button data-rate="31557600">1 yr/s</button>
      </div>
    </div>

    <script>
      import { SolarSystemRenderer } from '../engine/SolarSystemRenderer'
      import { EntryPanel } from '../engine/EntryPanel'

      const canvas = document.getElementById('scene') as HTMLCanvasElement
      const engine = new SolarSystemRenderer({ canvas })
      engine.start()
      new EntryPanel(document.body)

      const epochLabel = document.getElementById('epoch')!
      setInterval(() => {
        epochLabel.textContent = engine.currentEpoch.toISOString().slice(0, 19) + 'Z'
      }, 100)

      const focusSelect = document.getElementById('focus') as HTMLSelectElement
      focusSelect.addEventListener('change', () => engine.setFocus(focusSelect.value))

      const rates = document.getElementById('rates')!
      rates.addEventListener('click', (e) => {
        const button = (e.target as HTMLElement).closest('button')
        if (!button) return
        engine.timeRate = Number(button.dataset.rate)
        for (const b of rates.querySelectorAll('button')) {
          b.dataset.active = String(b === button)
        }
      })
    </script>
  </body>
</html>
