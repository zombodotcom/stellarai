---
// The engine island. Everything below the fold is client-side three.js;
// the physics lives in @stellarai/astro-core and @stellarai/scale-graph,
// both fully unit-tested — this page only hosts the canvas and controls.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>StellarAI</title>
    <style is:global>
      :root {
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        height: 100%;
        background: #02030a;
        color: #cdd6e8;
        font-family: system-ui, sans-serif;
        overflow: hidden;
      }
      #scene {
        display: block;
        width: 100vw;
        height: 100vh;
        touch-action: none;
      }
      #hud {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background: rgba(4, 8, 20, 0.72);
        border: 1px solid #24304a;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        backdrop-filter: blur(4px);
      }
      #hud h1 {
        margin: 0;
        font-size: 1rem;
        letter-spacing: 0.08em;
        font-weight: 600;
      }
      #hud .row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      #epoch {
        font-variant-numeric: tabular-nums;
        color: #8fa3c8;
      }
      select,
      button {
        background: #0b1224;
        color: #cdd6e8;
        border: 1px solid #2b3a5c;
        border-radius: 0.3rem;
        padding: 0.2rem 0.5rem;
        font-size: 0.85rem;
      }
      button[data-active='true'] {
        border-color: #6b93d6;
        color: #fff;
      }
      #entry-panel {
        position: fixed;
        top: 0.75rem;
        right: 0.75rem;
        width: 292px;
        background: rgba(4, 8, 20, 0.72);
        border: 1px solid #24304a;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        backdrop-filter: blur(4px);
      }
      #entry-panel h2 {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        font-weight: 600;
        color: #8fa3c8;
      }
      #entry-panel .row {
        display: grid;
        grid-template-columns: 6.2rem 1fr 4.6rem;
        align-items: center;
        gap: 0.4rem;
        margin: 0.25rem 0;
      }
      #entry-panel .row span {
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: #8fa3c8;
      }
      #entry-panel input[type='range'] {
        width: 100%;
      }
      #entry-panel .readout {
        display: flex;
        gap: 1rem;
        margin: 0.6rem 0 0.4rem;
      }
      #entry-panel .readout div {
        display: flex;
        flex-direction: column;
      }
      #entry-panel .readout span {
        font-size: 0.95rem;
        color: #fff;
        font-variant-numeric: tabular-nums;
      }
      #entry-panel .readout small {
        color: #64769a;
      }
      #entry-panel svg {
        width: 100%;
        background: rgba(10, 16, 34, 0.6);
        border-radius: 0.3rem;
      }
      #entry-panel .note {
        margin: 0.5rem 0 0;
        color: #64769a;
        font-size: 0.68rem;
        line-height: 1.35;
      }
      #nav-panel {
        position: fixed;
        bottom: 0.75rem;
        left: 0.75rem;
        width: 320px;
        background: rgba(4, 8, 20, 0.72);
        border: 1px solid #24304a;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        backdrop-filter: blur(4px);
      }
      #nav-panel h2 {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        font-weight: 600;
        color: #8fa3c8;
      }
      #nav-panel .row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.3rem 0;
      }
      #nav-panel label {
        min-width: 5.6rem;
      }
      #btn-back {
        background: #16233f;
        color: #9fb4d8;
        border: 1px solid #2b3a5c;
        border-radius: 0.3rem;
        padding: 0.2rem 0.55rem;
        font-size: 0.78rem;
        cursor: pointer;
        margin-right: 0.5rem;
      }
      #btn-back:disabled {
        opacity: 0.35;
        cursor: default;
      }
      #nav-panel input[type='checkbox'] {
        accent-color: #5fd77a;
      }
      #nav-panel select[data-k='browse'] {
        flex: 1;
        background: #0b1224;
        color: #cdd6e8;
        border: 1px solid #2b3a5c;
        border-radius: 0.3rem;
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
        max-width: 100%;
      }
      #nav-panel input[list] {
        flex: 1;
        background: #0b1224;
        color: #cdd6e8;
        border: 1px solid #2b3a5c;
        border-radius: 0.3rem;
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
      }
      #nav-panel input[type='range'] {
        flex: 1;
      }
      #nav-panel .row span {
        min-width: 3.4rem;
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: #8fa3c8;
      }
      #nav-panel .buttons {
        justify-content: flex-start;
      }
      #transfer-panel {
        position: fixed;
        bottom: 0.75rem;
        right: 0.75rem;
        width: 322px;
        background: rgba(4, 8, 20, 0.72);
        border: 1px solid #24304a;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.8rem;
        backdrop-filter: blur(4px);
      }
      #transfer-panel h2 {
        margin: 0 0 0.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        font-weight: 600;
        color: #8fa3c8;
      }
      #transfer-panel .row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0.3rem 0;
      }
      #transfer-panel input[type='number'] {
        width: 4.6rem;
        background: #0b1224;
        color: #cdd6e8;
        border: 1px solid #2b3a5c;
        border-radius: 0.3rem;
        padding: 0.2rem 0.4rem;
      }
      #transfer-panel .windows {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-top: 0.4rem;
      }
      #transfer-panel .window-row {
        text-align: left;
        font-family: ui-monospace, monospace;
        font-size: 0.72rem;
        white-space: pre;
        padding: 0.22rem 0.45rem;
      }
      #transfer-panel .window-row.selected {
        border-color: #e8b45a;
        color: #fff;
      }
      #transfer-panel .note {
        margin-top: 0.4rem;
        color: #64769a;
        font-size: 0.7rem;
        min-height: 0.9rem;
      }
      #panel-tabs {
        display: none;
      }
      @media (max-width: 820px) {
        #hud,
        #entry-panel,
        #nav-panel,
        #transfer-panel {
          display: none;
          position: fixed;
          left: 0.5rem;
          right: 0.5rem;
          bottom: 3.4rem;
          top: auto;
          width: auto;
          max-height: 55vh;
          overflow-y: auto;
        }
        #hud.open,
        #entry-panel.open,
        #nav-panel.open,
        #transfer-panel.open {
          display: block;
        }
        #panel-tabs {
          display: flex;
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          gap: 1px;
          background: #10182c;
          border-top: 1px solid #24304a;
          z-index: 10;
        }
        #panel-tabs button {
          flex: 1;
          border: none;
          border-radius: 0;
          padding: 0.6rem 0.2rem;
          font-size: 0.75rem;
          background: rgba(4, 8, 20, 0.92);
        }
        #panel-tabs button[data-active='true'] {
          color: #fff;
          background: #16233f;
        }
      }
      .star-label {
        position: fixed;
        top: 0;
        left: 0;
        color: #b8c6e2;
        font-size: 0.72rem;
        text-shadow: 0 0 4px #000;
        pointer-events: none;
        padding-left: 0.55rem;
        white-space: nowrap;
        z-index: 5;
      }
      #nav-panel .cruise {
        margin-top: 0.35rem;
        color: #8fa3c8;
        font-size: 0.72rem;
        line-height: 1.4;
        min-height: 1rem;
        font-variant-numeric: tabular-nums;
      }
      #nav-panel .result {
        margin-top: 0.4rem;
        min-height: 1.1rem;
        color: #5fd77a;
        font-variant-numeric: tabular-nums;
      }
    </style>
  </head>
  <body>
    <canvas id="scene"></canvas>
    <div id="hud">
      <button id="btn-back" title="return to previous stop">&#9664; back</button>
      <h1>StellarAI</h1>
      <div class="row">
        <span id="epoch"></span>
      </div>
      <div class="row">
        <span id="stars" style="color: #64769a"></span>
      </div>
      <div class="row">
        <label for="focus">focus</label>
        <select id="focus">
          <option value="sun" selected>Sun</option>
          <option value="mercury">Mercury</option>
          <option value="venus">Venus</option>
          <option value="earth">Earth</option>
          <option value="mars">Mars</option>
          <option value="jupiter">Jupiter</option>
          <option value="saturn">Saturn</option>
          <option value="uranus">Uranus</option>
          <option value="neptune">Neptune</option>
          <option value="pluto">Pluto</option>
        </select>
      </div>
      <div class="row" id="rates">
        <button data-rate="0" data-active="true">pause</button>
        <button data-rate="86400">1 d/s</button>
        <button data-rate="2592000">30 d/s</button>
        <button data-rate="31557600">1 yr/s</button>
      </div>
    </div>

    <div id="panel-tabs">
      <button data-panel="hud">time</button>
      <button data-panel="nav-panel">navigate</button>
      <button data-panel="transfer-panel">missions</button>
      <button data-panel="entry-panel">entry</button>
    </div>

    <script>
      import { SolarSystemRenderer } from '../engine/SolarSystemRenderer'
      import { EntryPanel } from '../engine/EntryPanel'
      import { NavPanel } from '../engine/NavPanel'
      import { TransferPanel } from '../engine/TransferPanel'

      const canvas = document.getElementById('scene') as HTMLCanvasElement
      const engine = new SolarSystemRenderer({ canvas })
      const starsLabel = document.getElementById('stars')!
      engine.onStarProgress = (s) => {
        starsLabel.textContent =
          s.chunksLoaded === s.chunksTotal
            ? `${s.starsLoaded.toLocaleString()} stars`
            : `${s.starsLoaded.toLocaleString()} stars (${s.chunksLoaded}/${s.chunksTotal})`
      }
      engine.start()

      const backBtn = document.querySelector('#btn-back')
      backBtn.addEventListener('click', () => {
        engine.goBack()
        backBtn.disabled = engine.historyDepth === 0
      })
      setInterval(() => {
        backBtn.disabled = engine.historyDepth === 0
      }, 1000)
      new EntryPanel(document.body)
      new NavPanel(document.body, engine)
      new TransferPanel(document.body, engine)

      const epochLabel = document.getElementById('epoch')!
      setInterval(() => {
        epochLabel.textContent = engine.currentEpoch.toISOString().slice(0, 19) + 'Z'
      }, 100)

      const focusSelect = document.getElementById('focus') as HTMLSelectElement
      focusSelect.addEventListener('change', () => engine.setFocus(focusSelect.value))

      // Mobile tab bar: one panel open at a time; tapping the active tab
      // closes it so the sky is never permanently covered.
      const tabs = document.getElementById('panel-tabs')!
      tabs.addEventListener('click', (e) => {
        const button = (e.target as HTMLElement).closest('button')
        if (!button) return
        const id = button.dataset.panel!
        const target = document.getElementById(id)!
        const opening = !target.classList.contains('open')
        for (const b of tabs.querySelectorAll('button')) b.dataset.active = 'false'
        for (const panelId of ['hud', 'nav-panel', 'transfer-panel', 'entry-panel']) {
          document.getElementById(panelId)?.classList.remove('open')
        }
        if (opening) {
          target.classList.add('open')
          button.dataset.active = 'true'
        }
      })

      const rates = document.getElementById('rates')!
      rates.addEventListener('click', (e) => {
        const button = (e.target as HTMLElement).closest('button')
        if (!button) return
        engine.timeRate = Number(button.dataset.rate)
        for (const b of rates.querySelectorAll('button')) {
          b.dataset.active = String(b === button)
        }
      })
    </script>
  </body>
</html>
